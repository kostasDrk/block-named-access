+bool ContentSecurityPolicy::AllowNamedAccess(const AtomicString& name, bool win){
+  String messageEnforce = "Access to the property '" + name + "' on " +
+          String((win) ? "window" : "document") + " would have returned an element with "
+          "the same name or ID. This was prevented for security reasons.";
+  String messageReportOnly = "Access to the property '" + name + "' on " +
+          String((win) ? "window" : "document") + " returns an element with "
+          "the same name or ID.";
+
+  bool shouldAllow = true;
+  for (const auto& policy : policies_) { // Iterate over all policies
+    if(policy->block_named_access) {
+      const bool enforce = policy->header->type == network::mojom::ContentSecurityPolicyType::kEnforce;
+      
+      if(enforce) shouldAllow = false; // Block named access if policy is not report-only
+
+      LogToConsole((enforce) ? messageEnforce : messageReportOnly); // Log to console
+      
+      ReportViolation(
+          GetDirectiveName(CSPDirectiveName::BlockNamedAccess),
+          CSPDirectiveName::BlockNamedAccess, (enforce) ? messageEnforce : messageReportOnly, KURL(),
+          policy->report_endpoints, policy->use_reporting_api,
+          policy->header->header_value, policy->header->type,
+          ContentSecurityPolicyViolationType::kInlineViolation, nullptr,
+          /*contextFrame=*/nullptr); // Raise `securitupolicyviolation` event and send violation report to `repot-uri` or `report-to` endpoints
+    }
+  }
+  return shouldAllow;
+}
+
 bool ContentSecurityPolicy::IsActive() const {
   return !policies_.empty();
 }
